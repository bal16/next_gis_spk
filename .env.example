# URL Backend NestJS yang dipanggil browser (Client-side)
NEXT_PUBLIC_NEST_API_URL=http://localhost:3001

# URL Backend NestJS yang dipanggil Next.js Server Components / SSR / Server Actions (Server-side)
NEST_API_URL=http://localhost:3001

# URL Publik Frontend (Opsional - dipakai untuk Canonical & OpenGraph metadata base)
# Kosongkan jika ingin otomatis mengikuti URL Vercel bawaan
# NEXT_PUBLIC_APP_URL=https://spk-gis.vercel.app
